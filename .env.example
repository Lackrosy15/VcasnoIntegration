# Copy to .env for Docker Compose. Never commit real tokens.
INTEGRATION_API_KEY=replace-with-a-long-random-secret
# Separate URL secret for incoming Kommo webhooks. Empty disables webhook access.
KOMMO_WEBHOOK_TOKEN=
# Set test for testing; leave empty to resolve FOP from lead field 2110073.
WEBHOOK_FOP_ID=
KOMMO_BASE_URL=https://example.kommo.com
KOMMO_TOKEN=
KOMMO_PRODUCT_CATALOG_ID=1613
KOMMO_FOP_FIELD_ID=2110073
# Default product price: field_code=PRICE. Set the ID if you use another field.
KOMMO_PRICE_FIELD_ID=0
KOMMO_PRICE_FIELD_CODE=PRICE
VCHASNO_TEST_TOKEN=
VCHASNO_ZELINSKA_TOKEN=
VCHASNO_VETROV_TOKEN=
VCHASNO_ZELINSKA_TAX_GROUP=2
VCHASNO_VETROV_TAX_GROUP=2
VCHASNO_ZELINSKA_PAYMENT_TYPE=1
VCHASNO_VETROV_PAYMENT_TYPE=1
DB_PASSWORD=replace-with-a-database-password
PORT=8080
